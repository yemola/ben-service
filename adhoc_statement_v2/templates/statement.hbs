<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RSA & Portfolio Statement</title>
  <link rel="stylesheet" href="../public/css/statement.css" />
</head>
<body>
  <div class="statement-container">
    
    <!-- Top Header with 4 Offices and Period Badge -->
    <header class="main-header">
      <div class="header-left">
        <div class="brand-section">
          {{#if logoUrl}}
            <img src="{{logoUrl}}" alt="Norrenberger Pensions" class="brand-logo-img" />
          {{else}}
            <img src="data:image/png;base64," alt="Norrenberger Pensions" class="brand-logo-img" />
          {{/if}}
        </div>    

        <div class="office-locations-grid">
          <div class="office-col">
            <strong>Head Office</strong>
            22, Otukpo Street, Off Gimbiya<br />Street, Area 11, Garki, Abuja.
          </div>
          <div class="office-col">
            <strong>Kano Office</strong>
            Ground floor, B-Centre Plaza, opp. Kano<br />State Assembly, Off Zaria Road, Kano
          </div>
          <div class="office-col">
            <strong>Lagos Office</strong>
            2b, Bayo Kuku Road, Off Alfred<br />Rewane Road, Ikoyi, Lagos.
          </div>
          <div class="office-col">
            <strong>Port Harcout Office</strong>
            No 10, Evo Road, GRA<br />Phase II, Port Harcout.
          </div>
        </div>
      </div>

      <div class="header-right">
        <div class="period-badge">
          <div class="period-line"><strong>Period:</strong> {{period.printedAt}}</div>
          <div class="period-line"><strong>Period:</strong> {{period.dateFrom}} - {{period.dateTo}}</div>
        </div>
      </div>
    </header>

    <!-- A. Personal Information -->
    <div class="section-bar">A. Personal Information</div>
    <div class="personal-info-grid">
      <div class="info-item">
        <span class="info-label">Account Name:</span>
        <span class="info-val">{{personalInfo.accountName}}</span>
      </div>
      <div class="info-item">
        <span class="info-label">PIN:</span>
        <span class="info-val">{{personalInfo.pin}}</span>
      </div>
      <div class="info-item">
        <span class="info-label">Employer:</span>
        <span class="info-val">{{personalInfo.employer}}</span>
      </div>
    </div>

    <!-- B. Portfolio Information -->
    <div class="section-bar">B. Portfolio Information</div>
    
    <!-- Hero Summary Card -->
    <div class="portfolio-hero-card">
      <div class="portfolio-hero-row">
        <div class="hero-metric">
          <div class="hero-label">Total portfolio value ( CPS + PPP )</div>
          <div class="hero-value-large">{{portfolio.totalCpsPpp}}</div>
        </div>
        <div class="hero-metric">
          <div class="hero-label">Gain/Loss from inception (combined)</div>
          <div class="hero-value-large">{{portfolio.combinedGainLoss}}</div>
        </div>
      </div>
      <div class="portfolio-hero-row">
        <div class="hero-metric">
          <div class="hero-label">Total portfolio value (Foreign Currency Fund VII)</div>
          <div class="hero-value-medium">{{portfolio.totalFcyFundVii}}</div>
        </div>
        <div class="hero-metric">
          <div class="hero-label">Gain/Loss from inception</div>
          <div class="hero-value-medium">{{portfolio.fcyGainLoss}}</div>
        </div>
      </div>
    </div>

    <!-- 3 Scheme Cards -->
    <div class="scheme-cards-grid">
      <!-- NORRENBERGER RSA SCHEME -->
      <div class="scheme-card">
        <div class="scheme-card-header header-orange">
          NORRENBERGER RSA SCHEME
        </div>
        <div class="scheme-card-body">
          <div>
            <div class="scheme-desc-title">RSA (Retirement Savings Account)</div>
            <div class="scheme-desc-sub">Mandatory contributions only.<br />Naira - denominated</div>
          </div>
          <div class="scheme-value-box">
            <div class="scheme-value">{{schemes.rsa.currentValue}}</div>
            <div class="scheme-value-label">Current Value</div>
          </div>
        </div>
      </div>

      <!-- MICRO PENSION SCHEME -->
      <div class="scheme-card">
        <div class="scheme-card-header header-green">
          MICRO PENSION SCHEME
        </div>
        <div class="scheme-card-body">
          <div>
            <div class="scheme-desc-title">PPP (Personal Pension Plan)</div>
            <div class="scheme-desc-sub">Voluntary Contribution only.<br />Naira denominated.</div>
          </div>
          <div class="scheme-value-box">
            <div class="scheme-value">{{schemes.microPension.currentValue}}</div>
            <div class="scheme-value-label">Current Value</div>
          </div>
        </div>
      </div>

      <!-- FOREIGN CURRENCY DOLLAR FUND VII -->
      <div class="scheme-card">
        <div class="scheme-card-header header-slate">
          FOREIGN CURRENCY DOLLAR FUND VII
        </div>
        <div class="scheme-card-body">
          <div>
            <div class="scheme-desc-title">FCY (Foreign Currency Fund)</div>
            <div class="scheme-desc-sub">USD-denominated.</div>
          </div>
          <div class="scheme-value-box">
            <div class="scheme-value">{{schemes.foreignCurrency.currentValue}}</div>
            <div class="scheme-value-label">Current Value</div>
          </div>
        </div>
      </div>
    </div>

    <!-- C1. NORRENBERGER RSA FUND II -->
    <div class="section-bar">C1. NORRENBERGER RSA FUND II</div>
    <div class="section-subtitle">Mandatory contributions from employer and employee since inception.</div>

    <div class="fund-summary-box">
      <div class="fund-cell">
        <div class="fund-cell-label">Total mandatory contributions</div>
        <div class="fund-cell-val">{{rsaFund.totalMandatory}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-cell-label">Gain / loss since inception</div>
        <div class="fund-cell-val">{{rsaFund.gainLoss}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-cell-label">Admin fee charged</div>
        <div class="fund-cell-val">{{rsaFund.adminFee}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-stacked-cell">
          <div class="stacked-sub-cell">
            <div class="fund-cell-label">Current Value</div>
            <div class="fund-cell-val">{{rsaFund.currentValue}}</div>
          </div>
          <div class="stacked-sub-cell with-border-top">
            <div class="fund-cell-label">Withdrawal</div>
            <div class="fund-cell-val">{{rsaFund.withdrawal}}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="table-subheading">Mandatory Contribution History</div>
    <table class="history-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Period</th>
          <th>Description</th>
          <th class="text-right">Employee</th>
          <th class="text-right">Employer</th>
          <th class="text-right">Other Cont.</th>
          <th class="text-right">Withdrawal</th>
          <th class="text-right">Fees</th>
          <th class="text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#if rsaFund.transactions.length}}
          {{#each rsaFund.transactions}}
            <tr>
              <td>{{transDate}}</td>
              <td>{{period}}</td>
              <td>{{description}}</td>
              <td class="text-right">{{employee}}</td>
              <td class="text-right">{{employer}}</td>
              <td class="text-right">{{otherCont}}</td>
              <td class="text-right">{{withdrawal}}</td>
              <td class="text-right">{{fees}}</td>
              <td class="text-right">{{total}}</td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="9" class="empty-txn-msg">No transaction history recorded for this period.</td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    <!-- C2. PERSONAL PENSION PLAN -->
    <div class="section-bar">C2. PERSONAL PENSION PLAN</div>
    <div class="section-subtitle">PPP Fund V holds your AVC (Additional Voluntary Contributions). There are no mandatory employer or employee contributions in this fund.</div>

    <div class="fund-summary-box">
      <div class="fund-cell">
        <div class="fund-cell-label">Total mandatory contributions</div>
        <div class="fund-cell-val">{{personalPension.totalMandatory}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-cell-label">Gain / loss since inception</div>
        <div class="fund-cell-val">{{personalPension.gainLoss}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-cell-label">Admin fee charged</div>
        <div class="fund-cell-val">{{personalPension.adminFee}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-stacked-cell">
          <div class="stacked-sub-cell">
            <div class="fund-cell-label">Current Value</div>
            <div class="fund-cell-val">{{personalPension.currentValue}}</div>
          </div>
          <div class="stacked-sub-cell with-border-top">
            <div class="fund-cell-label">Withdrawal</div>
            <div class="fund-cell-val">{{personalPension.withdrawal}}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="table-subheading">Foreign currency fund transaction history</div>
    <table class="history-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Period</th>
          <th>Description</th>
          <th class="text-right">Employee</th>
          <th class="text-right">Employer</th>
          <th class="text-right">Other Cont.</th>
          <th class="text-right">Withdrawal</th>
          <th class="text-right">Fees</th>
          <th class="text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#if personalPension.transactions.length}}
          {{#each personalPension.transactions}}
            <tr>
              <td>{{transDate}}</td>
              <td>{{period}}</td>
              <td>{{description}}</td>
              <td class="text-right">{{employee}}</td>
              <td class="text-right">{{employer}}</td>
              <td class="text-right">{{otherCont}}</td>
              <td class="text-right">{{withdrawal}}</td>
              <td class="text-right">{{fees}}</td>
              <td class="text-right">{{total}}</td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="9" class="empty-txn-msg">No transaction history recorded for this period.</td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    <!-- C3. Information On Dollar Fund (FOREIGN CURRENCY DOLLAR FUND VII) -->
    <div class="section-bar">C3. Information On Dollar Fund (FOREIGN CURRENCY DOLLAR FUND VII)</div>
    <div class="section-subtitle">Fund VII is USD-denominated. All inflows are in US Dollars. A Naira equivalent is provided at the prevailing CBN exchange rate at statement date. Admin fees are charged in USD.</div>

    <div class="fund-summary-box">
      <div class="fund-cell">
        <div class="fund-cell-label">Total mandatory contributions</div>
        <div class="fund-cell-val">{{dollarFund.totalMandatory}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-cell-label">Gain / loss since inception</div>
        <div class="fund-cell-val">{{dollarFund.gainLoss}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-cell-label">Admin fee charged</div>
        <div class="fund-cell-val">{{dollarFund.adminFee}}</div>
      </div>
      <div class="fund-cell">
        <div class="fund-stacked-cell">
          <div class="stacked-sub-cell">
            <div class="fund-cell-label">Current Value</div>
            <div class="fund-cell-val">{{dollarFund.currentValue}}</div>
          </div>
          <div class="stacked-sub-cell with-border-top">
            <div class="fund-cell-label">Withdrawal</div>
            <div class="fund-cell-val">{{dollarFund.withdrawal}}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="table-subheading">Foreign currency fund transaction history</div>
    <table class="history-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Period</th>
          <th>Description</th>
          <th class="text-right">Employee</th>
          <th class="text-right">Employer</th>
          <th class="text-right">Other Cont.</th>
          <th class="text-right">Withdrawal</th>
          <th class="text-right">Fees</th>
          <th class="text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#if dollarFund.transactions.length}}
          {{#each dollarFund.transactions}}
            <tr>
              <td>{{transDate}}</td>
              <td>{{period}}</td>
              <td>{{description}}</td>
              <td class="text-right">{{employee}}</td>
              <td class="text-right">{{employer}}</td>
              <td class="text-right">{{otherCont}}</td>
              <td class="text-right">{{withdrawal}}</td>
              <td class="text-right">{{fees}}</td>
              <td class="text-right">{{total}}</td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="9" class="empty-txn-msg">No transaction history recorded for this period.</td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    <!-- Page 4 Closing Section: Signature, Stamp, Notes, and Banner -->
    <section class="closing-section">
      <div class="signoff-stamp-row">
        <div class="signature-block">
          {{#if signatureUrl}}
            <img src="{{signatureUrl}}" alt="Signature" class="signature-img" />
          {{else}}
            <img src="data:image/png;base64," alt="Signature" class="signature-img" />
          {{/if}}
          <div class="signature-name">{{signatory.name}}</div>
          <div class="signature-title">{{signatory.title}}</div>
        </div>

        <div class="stamp-block">
          {{#if stampUrl}}
            <img src="{{stampUrl}}" alt="Approved Stamp" class="stamp-img" />
          {{else}}
            <img src="data:image/png;base64," alt="Approved Stamp" class="stamp-img" />
          {{/if}}
        </div>
      </div>

      <div class="closing-notes-block">
        <p>
          <span class="note-highlight">Note:</span> Nörrenberger Pensions Limited charges an Administration Fee of N100 monthly, in addition to 7.5% VAT, deducted from your contributions. Fees are regulated by the National Pension Commission and are subject to change with prior notice where applicable.
        </p>
        <p class="contact-line">
          <strong>Contact Us:</strong> Head Office: No. 22 Otukpo Street, Off Gimbiya Street, Area 11, Garki, Abuja.<br />
          <strong>Tel:</strong> 07002200300 &nbsp;|&nbsp; <strong>Email:</strong> clientservice@norrenpensions.com &nbsp;|&nbsp; <strong>Website:</strong> www.norrenpensions.com
        </p>
        <p class="social-handles-line">
          <strong>Stay in Touch:</strong> @norrenbergerpensions &nbsp;&nbsp; @norrenpensions
        </p>
      </div>

      <div class="footer-banner-container">
        {{#if bannerUrl}}
          <img src="{{bannerUrl}}" alt="Retirement Banner" class="footer-banner-img" />
        {{else}}
          <img src="data:image/png;base64," alt="Retirement Banner" class="footer-banner-img" />
        {{/if}}
      </div>
    </section>

  </div>
</body>
</html>
